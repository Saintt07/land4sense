# Copy to .env and fill in. .env is never committed.

# MySQL — the API connects only as the least-privilege l4s_app account (sql/03_app_user.sql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=landslide4sense
DB_USER=l4s_app
DB_PASSWORD=CHANGE_ME

# Comma-separated website origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
